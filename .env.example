# Copy to .env.local and fill in. Never commit .env.local.
# Validated by src/lib/env.public.ts and src/lib/env.ts.

# --- Public (inlined into the browser bundle; no secrets here) ---
# Local values come from `npx supabase start` (needs Docker).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public base URL of the R2 media bucket (custom domain on the bucket).
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.example.com
# Platform domain for storefront subdomains (shopnest.in in production).
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# --- Server only ---
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
