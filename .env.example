# Copy to .env.local and fill in. Never commit .env.local.
# Validated by src/lib/env.public.ts and src/lib/env.ts.

# --- Public (inlined into the browser bundle; no secrets here) ---
# Local values: run `npx supabase status` (needs Docker) and copy API_URL
# and ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Where R2 object keys are served from: /mock-media locally (files in
# public/), the bucket's custom domain in production
# (e.g. https://media.shopnest.in).
NEXT_PUBLIC_MEDIA_BASE_URL=/mock-media
# Platform domain. Stores live on <slug>.<this>, the dashboard on app.<this>.
# Locally: localhost:3000, so http://saree-demo.localhost:3000 and
# http://app.localhost:3000. Production: shopnest.in.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# --- Server only ---
# Local value: SERVICE_ROLE_KEY from `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=
# R2 credentials; needed from Phase 3 (image uploads).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
