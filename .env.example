# Copy to .env.local and fill in. Never commit .env.local.
# Validated by src/lib/env.public.ts and src/lib/env.ts.

# --- Public (inlined into the browser bundle; no secrets here) ---
# Local values: run `npx supabase status` (needs Docker) and copy API_URL
# and ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Where R2 object keys are served from. Without R2: /mock-media (the demo
# photos in public/; uploads stay off). With R2: the bucket's public
# address (https://pub-<id>.r2.dev in development, its own image domain in
# production), after copying the demo photos there with
# `npm run media:upload-demo`. Restart `npm run dev` after changing it.
NEXT_PUBLIC_MEDIA_BASE_URL=/mock-media
# Platform domain. Stores live on <slug>.<this>, the dashboard on app.<this>.
# Locally: localhost:3000, so http://saree-demo.localhost:3000 and
# http://app.localhost:3000. Production: zarify.in.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# --- Server only ---
# Local value: SERVICE_ROLE_KEY from `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=
# R2 credentials for photo uploads: an API token with Object Read & Write
# on this bucket only. The bucket's CORS policy must allow PUT with the
# content-type header from the app host (http://app.localhost:3000 locally).
# Without them, uploads are off and the photo upload e2e test is skipped.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
